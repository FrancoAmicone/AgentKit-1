# Coinbase Developer Platform — https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Marketplace receiver (npm run setup:wallets). Agent wallets are per-user now.
MARKETPLACE_WALLET_ADDRESS=

# Optional legacy / DEMO_SHARED_AGENT only
# AGENT_WALLET_ADDRESS=

# Optional — better natural-language search (otherwise rules parser is used)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# CdpX402Client also reads this; development = Base Sepolia
CDP_X402_CLIENT_ENVIRONMENT=development

# Phase 2A: require AgentBook human-backed agent before purchase (default true)
REQUIRE_HUMAN_BACKED_AGENT=true

# Multi-user: leave unset/false so each browser creates its own CDP agent.
# DEMO_SHARED_AGENT=true

# Optional RPC for reading agent USDC/ETH balances
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: override AgentBook registration relay (default hosted World relay)
# AGENTBOOK_RELAY_URL=https://x402-worldchain.vercel.app

# Optional: World ID app for register + HITL (defaults to AgentBook public app id)
# WORLD_ID_APP_ID=app_a7c3e2b6b83927251a0db5345bd7146a

# Phase 2B (optional): override hardcoded default auto-pay limit (0.1 USDC).
# DEFAULT_AUTO_PAY_LIMIT_USDC=0.1

# Phase 3 — 0G Storage receipts (official SDK @0gfoundation/0g-storage-ts-sdk)
# Docs: https://build.0g.ai/storage · https://docs.0g.ai/developer-hub/building-on-0g/storage/sdk
# See docs/13-env-and-0g-setup.md
# OG_PRIVATE_KEY=0x…
# OG_NETWORK=testnet
# OG_STORAGE_MODE=turbo
# OG_EVM_RPC=https://evmrpc-testnet.0g.ai
# OG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
